{
  "name": "dsh-relay-reasoning",
  "version": "2.1.0",
  "description": "让 DSH 支持中转站的推理等级：为每个模型提供关/低/中/高/max 五档可选，适配任意 OpenAI 兼容中转站。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "reasoning-effort",
    "relay",
    "openai-compatible",
    "llm"
  ],
  "license": "MIT",
  "author": "wuwan911-cell",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wuwan911-cell/dsh-relay-reasoning.git"
  },
  "homepage": "https://github.com/wuwan911-cell/dsh-relay-reasoning#readme",
  "bugs": {
    "url": "https://github.com/wuwan911-cell/dsh-relay-reasoning/issues"
  },
  "type": "module",
  "main": "./index.js",
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.1-rc.1"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.1-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  }
}
