{
  "name": "dsh-relay-reasoning",
  "version": "1.3.0",
  "description": "Give every model on an OpenAI-compatible relay real reasoning levels (off / low / medium / high, plus opt-in max) in the DSH model picker.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "reasoning-effort",
    "relay",
    "openai-compatible",
    "llm"
  ],
  "license": "MIT",
  "author": "wuwan911-cell",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wuwan911-cell/dsh-relay-reasoning.git"
  },
  "homepage": "https://github.com/wuwan911-cell/dsh-relay-reasoning#readme",
  "bugs": {
    "url": "https://github.com/wuwan911-cell/dsh-relay-reasoning/issues"
  },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.1-rc.1"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.1-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  }
}
